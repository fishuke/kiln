# Copy to .env. Everything is optional; Kiln runs locally without any of it.

# Bring your own model access (any of these)
CLAUDE_CODE_OAUTH_TOKEN=        # from `claude setup-token` (Claude subscription)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
KILN_AGENTS=scripted            # set to "real" to run Claude Code / Codex / OpenCode

# Code forge (GitHub App installation token) and webhooks
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Trackers and chat
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_WEBHOOK_SECRET=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Typed decisions (optional): Jev, with an LLM gateway as fallback
JEV_API_URL=
JEV_API_KEY=
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=

# Previews (optional)
VERCEL_TOKEN=
VERCEL_PROJECT=

# People and roles
KILN_ROLES=po=po@example.com;code-owners=lead@example.com;admins=admin@example.com
KILN_SECRET_KEY=                # signs run tokens; set a long random value
