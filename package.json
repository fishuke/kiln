{
  "name": "kiln",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @kiln/web build",
    "lint": "pnpm --filter @kiln/web lint",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @kiln/web exec tsc --noEmit",
    "test": "vitest run && pnpm --filter @kiln/web test",
    "e2e": "vitest run e2e",
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:mcp": "tsx apps/mcp/src/main.ts",
    "kiln": "node packages/cli/bin/kiln.mjs",
    "docs:gen": "tsx scripts/gen-docs.ts",
    "dev:web": "pnpm --filter @kiln/web dev",
    "dev:up": "docker compose up -d --build",
    "health": "node scripts/health.mjs",
    "format": "prettier --write .",
    "smoke:claude": "tsx scripts/smoke-claude.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@kiln/api": "workspace:*",
    "@kiln/auth": "workspace:*",
    "@kiln/cli": "workspace:*",
    "@kiln/decide": "workspace:*",
    "@kiln/definitions": "workspace:*",
    "@kiln/engine": "workspace:*",
    "@kiln/events": "workspace:*",
    "@kiln/evidence": "workspace:*",
    "@kiln/harness": "workspace:*",
    "@kiln/integrations": "workspace:*",
    "@kiln/mcp": "workspace:*",
    "@kiln/sandbox": "workspace:*",
    "@kiln/schema": "workspace:*",
    "@kiln/sdk-ts": "workspace:*",
    "@kiln/store": "workspace:*",
    "@kiln/studio": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "kiln": "packages/cli/bin/kiln.mjs"
  }
}
